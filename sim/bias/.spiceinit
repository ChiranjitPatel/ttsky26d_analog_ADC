* ngspice init for sky130 (from $PDK_ROOT/sky130A/libs.tech/ngspice/spinit, adapted for ngspice-36)
set ngbehavior=hsa     ; compatibility mode for reading the PDK libs
set skywaterpdk        ; skip some checks for faster lib loading
set ng_nomodcheck      ; don't check the model parameters
set num_threads=4
option noinit          ; don't print operating point data
